#!/usr/bin/env -S guile
# -*- scheme -*- !#

;; (add-to-load-path "/<huntest>/source")
(import (prefix (huntest) hut::)
        (prefix (huntest iverilog) iverilog::))

(hut::run
 (hut::make-testbench
  #:name "testbench name"
  #:tests
  (hut::make-test
   #:name "test name"
   #:body
   (iverilog::test-body-simple
    #:sources '("template-iverilog-simple-tb.sv")
    #:top "testbench"
    ;; optional arguments
    #:compile-flags '()         ; e.g "-g2012"
    #:runtime-flags '()         ; e.g "-fst"
    #:include-paths '()
    #:defines '()
    #:parameters '()
    #:fail-on-warnings? #f
    #:init (lambda (plusargs base-path tb-path test-path) #t)
    #:finish (lambda (plusargs base-path tb-path test-path) #t)))))
