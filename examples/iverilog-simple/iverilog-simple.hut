#!/usr/bin/env -S guile
# -*- scheme -*- !#

(add-to-load-path "../../source")

(import (prefix (huntest) hut::)
        (prefix (huntest iverilog) iverilog::))

(hut::run
 (hut::make-testbench
  #:name "Simple iverilog testbench"
  #:tests
  (hut::make-test
   #:name "simulation"
   #:body
   (iverilog::test-body-simple
    #:compile-flags '("-g2012")
    #:runtime-flags '("-fst")
    #:sources '("testbench.sv")
    #:top "testbench"))))
